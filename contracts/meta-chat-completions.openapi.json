{
  "openapi": "3.0.3",
  "info": {
    "title": "Collective 101 Meta adapter consumer contract",
    "version": "0.1.0",
    "description": "The subset used by this client, derived from Meta's tool-calling documentation. Not a complete or official Meta API specification. Live compatibility remains unverified."
  },
  "servers": [{"url": "https://api.meta.ai/v1"}],
  "security": [{"bearerAuth": []}],
  "paths": {
    "/chat/completions": {
      "post": {
        "operationId": "createAgentCompletion",
        "summary": "Request an assistant message, optionally containing function tool calls",
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompletionRequest"}}}
        },
        "responses": {
          "200": {"description": "Assistant message and optional usage", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CompletionResponse"}}}},
          "400": {"description": "Invalid request; client treats it as non-retryable"},
          "401": {"description": "Authentication failure; client treats it as non-retryable"},
          "403": {"description": "Authorization failure; client treats it as non-retryable"},
          "429": {"description": "Rate limited; client classifies it as retryable within task-attempt and call limits"},
          "503": {"description": "Unavailable; client classifies server errors as retryable within task-attempt and call limits"}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {"bearerAuth": {"type": "http", "scheme": "bearer"}},
    "schemas": {
      "FunctionCall": {
        "type": "object", "required": ["id", "type", "function"],
        "properties": {
          "id": {"type": "string"}, "type": {"type": "string", "enum": ["function"]},
          "function": {"type": "object", "required": ["name", "arguments"], "properties": {
            "name": {"type": "string"}, "arguments": {"type": "string", "description": "JSON-encoded object"}
          }}
        }
      },
      "Message": {
        "type": "object", "required": ["role"],
        "properties": {
          "role": {"type": "string", "enum": ["system", "user", "assistant", "tool"]},
          "content": {"type": "string", "nullable": true},
          "tool_call_id": {"type": "string"},
          "tool_calls": {"type": "array", "items": {"$ref": "#/components/schemas/FunctionCall"}}
        }
      },
      "CompletionRequest": {
        "type": "object", "required": ["model", "messages", "max_tokens"],
        "properties": {
          "model": {"type": "string", "example": "muse-spark-1.3"},
          "messages": {"type": "array", "minItems": 1, "items": {"$ref": "#/components/schemas/Message"}},
          "max_tokens": {"type": "integer", "example": 4096},
          "tool_choice": {"type": "string", "enum": ["auto"]},
          "parallel_tool_calls": {"type": "boolean"},
          "tools": {"type": "array", "items": {"type": "object", "required": ["type", "function"], "properties": {
            "type": {"type": "string", "enum": ["function"]},
            "function": {"type": "object", "required": ["name", "description", "parameters"], "properties": {
              "name": {"type": "string"}, "description": {"type": "string"}, "parameters": {"type": "object"}
            }}
          }}}
        }
      },
      "CompletionResponse": {
        "type": "object", "required": ["choices"],
        "properties": {
          "choices": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["message"], "properties": {
            "message": {"$ref": "#/components/schemas/Message"}, "finish_reason": {"type": "string"}
          }}},
          "usage": {"type": "object", "properties": {"total_tokens": {"type": "integer", "minimum": 0}}}
        }
      }
    }
  }
}
